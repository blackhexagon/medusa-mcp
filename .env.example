# Docker image (pin a version for production, e.g. ghcr.io/blackhexagon/medusa-mcp:0.1.0)
MEDUSA_MCP_IMAGE=ghcr.io/blackhexagon/medusa-mcp:latest

# Medusa backend URL (without /admin)
MEDUSA_BASE_URL=https://api.example-shop.com

# Option A (recommended): secret API key, created in Medusa Admin > Settings > Secret API Keys
MEDUSA_API_KEY=sk_...

# Option B: admin user credentials (used only when MEDUSA_API_KEY is empty)
# MEDUSA_ADMIN_EMAIL=admin@example.com
# MEDUSA_ADMIN_PASSWORD=...

# Bearer token(s) that MCP clients must send. Comma-separated to allow several clients / rotation.
# Generate: openssl rand -hex 32
MCP_AUTH_TOKENS=change-me-to-a-long-random-token

# Optional
# MCP_TOOL_MODE=dynamic          # dynamic (5 meta tools, default) | full (1 tool per endpoint)
# MEDUSA_READ_ONLY=false         # true = only GET operations
# MEDUSA_INCLUDE_TAGS=Products,Orders,Customers
# MEDUSA_EXCLUDE_TAGS=Users,Api Keys,Invites
# MEDUSA_EXCLUDE_OPERATIONS=DeleteProductsId
# MEDUSA_ALLOW_RAW_REQUESTS=true # allow calling /admin/* routes that are not in the spec
# MCP_ALLOW_QUERY_TOKEN=false    # allow ?token=... for clients that cannot send headers
# MCP_MAX_RESPONSE_CHARS=60000
# LOG_LEVEL=info
