{
  "name": "medusa-mcp",
  "version": "0.2.1",
  "description": "MCP server for the Medusa v2 Admin API (Streamable HTTP + stdio), generated from the Medusa OpenAPI spec.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "medusa-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "generated"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:spec": "tsx scripts/build-spec.ts openapi.yaml generated/spec.json",
    "build": "npm run build:spec && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test test/*.test.ts"
  },
  "keywords": [
    "mcp",
    "medusa",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blackhexagon/medusa-mcp.git"
  },
  "homepage": "https://github.com/blackhexagon/medusa-mcp"
}
